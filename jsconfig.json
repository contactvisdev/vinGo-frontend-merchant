{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ],
            "@core/*": [
                "./src/core/*"
            ],
            "@app/*": [
                "./src/app/*"
            ],
            "@hooks/*": [
                "./src/hooks/*"
            ]
        }
    },
    "include": [
        "src"
    ]
}